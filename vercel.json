{
  "routes": [
    {
      "src": "/onboarding/name",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/name"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/priorities",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/priorities"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/phone",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/phone"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/phone-code",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/phone-code"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/google",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/google"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/email-success",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/email-success"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/subscribe",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/subscribe"
        }
      ],
      "continue": true
    },
    {
      "src": "/onboarding/complete",
      "transforms": [
        {
          "type": "request.headers",
          "op": "delete",
          "target": {
            "key": "x-remi-onboarding-pathname"
          }
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-onboarding-pathname"
          },
          "args": "/onboarding/complete"
        }
      ],
      "continue": true
    },
    {
      "src": "/api/onboarding/guided(?:/(.*))?",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-guided-signup-origin"
          },
          "args": "https://hireremi.ai"
        }
      ],
      "continue": true
    },
    {
      "src": "/api/auth/google/callback",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-guided-signup-origin"
          },
          "args": "https://hireremi.ai"
        }
      ],
      "continue": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/onboarding/entry",
      "destination": "https://app.hireremi.ai/start"
    },
    {
      "source": "/onboarding/:path*",
      "destination": "https://app.hireremi.ai/onboarding/:path*"
    },
    {
      "source": "/api/onboarding/guided/:path*",
      "destination": "https://app.hireremi.ai/api/onboarding/guided/:path*"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "https://app.hireremi.ai/api/auth/google/callback"
    },
    {
      "source": "/api/billing/checkout-session",
      "destination": "https://app.hireremi.ai/api/billing/checkout-session"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://app.hireremi.ai/_next/:path*"
    },
    {
      "source": "/images/onboarding/:path*",
      "destination": "https://app.hireremi.ai/images/onboarding/:path*"
    },
    {
      "source": "/terms",
      "destination": "https://app.hireremi.ai/terms"
    },
    {
      "source": "/privacy",
      "destination": "https://app.hireremi.ai/privacy"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
