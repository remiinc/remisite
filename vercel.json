{
  "routes": [
    {
      "src": "/api/onboarding/guided(?:/(.*))?",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-guided-signup-origin"
          },
          "args": "https://hireremi.ai"
        }
      ],
      "continue": true
    },
    {
      "src": "/api/integrations/google(?:/(.*))?",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-guided-signup-origin"
          },
          "args": "https://hireremi.ai"
        }
      ],
      "continue": true
    },
    {
      "src": "/api/auth/google/callback",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-remi-guided-signup-origin"
          },
          "args": "https://hireremi.ai"
        }
      ],
      "continue": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/onboarding/entry",
      "destination": "https://app.hireremi.ai/start"
    },
    {
      "source": "/onboarding/:path*",
      "destination": "https://app.hireremi.ai/onboarding/:path*"
    },
    {
      "source": "/api/onboarding/guided/:path*",
      "destination": "https://app.hireremi.ai/api/onboarding/guided/:path*"
    },
    {
      "source": "/api/integrations/google/:path*",
      "destination": "https://app.hireremi.ai/api/integrations/google/:path*"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "https://app.hireremi.ai/api/auth/google/callback"
    },
    {
      "source": "/api/billing/checkout-session",
      "destination": "https://app.hireremi.ai/api/billing/checkout-session"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://app.hireremi.ai/_next/:path*"
    },
    {
      "source": "/images/onboarding/:path*",
      "destination": "https://app.hireremi.ai/images/onboarding/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
